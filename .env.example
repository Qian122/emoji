PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
AI_SERVICE_TOKEN=replace-with-a-separate-ai-service-token
ADMIN_REGISTRATION_CODE=change-me-before-enabling-admin-registration
DB_PATH=./data/emoji-checker.db
SEED_DEMO_DATA=true
AI_BACKEND_URL=http://localhost:3000
