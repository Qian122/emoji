AI_SAMPLE_INTERVAL_SECONDS=3
AI_CONFIDENCE_THRESHOLD=0.65
AI_CAMERA_INDEX=0
AI_DETECTOR_BACKENDS=opencv,mtcnn
AI_FACE_EXPAND_PERCENTAGE=15
AI_TEMPORAL_WINDOW=3
AI_TEMPORAL_TTL_SECONDS=15
AI_MIN_TEMPORAL_AGREEMENT=0.67
AI_MIN_EMOTION_MARGIN=0.12
AI_CONFUSED_MIN_MARGIN=0.20
AI_THRESHOLD_HAPPY=0.68
AI_THRESHOLD_NEUTRAL=0.70
AI_THRESHOLD_CONFUSED=0.75
AI_THRESHOLD_DISGUST=0.72
AI_THRESHOLD_ANGRY=0.70
AI_THRESHOLD_SAD=0.70
AI_THRESHOLD_SURPRISED=0.70

