{
  "name": "emoji-classroom-checker",
  "version": "1.0.0",
  "private": true,
  "description": "表情符号课堂情绪检查器系统",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/*.test.js",
    "test:ai": "python -m unittest discover -s ai-service -p test_*.py",
    "check": "node --check server/app.js && node --check server/db.js && node --check server/index.js && node --check server/realtime.js && node --check server/openapi.js && node --check public/app.js && python -m py_compile ai-service/main.py"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-stringify": "^6.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
